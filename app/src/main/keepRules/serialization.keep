# ==============================================================================
# kotlinx.serialization 多态 sealed 家族与合成序列化器防裁剪契约
#
# 背景（华灯 release 闪退实证 & 本仓 R8 防线）：
# `kotlinx-serialization-r8.pro` 默认规则带 `allowshrinking`——当某个 `@Serializable` sealed
# 子类仅在反序列化路径使用、无直接构造调用（例如 `@Deprecated` 历史消息分片、备份兼容子类、
# 尚未接线的厂商配置子类）时，R8 Full Mode 会将该子类判定为未实例化而裁剪，或通过
# HorizontalClassMerger 将多个子类合并成同一 Class，导致运行时 `SealedClassSerializer`
# 报 `Serializer for subclass ... not found` 或类型键冲突崩溃。
#
# 纪律（由 `SerializationKeepTest` 自动守卫，新增 `@Serializable sealed` 家族必须登记到此）：
# 1. 基类与 `* extends <Base>` 继承链一律使用 `-keep`（严禁 `allowshrinking` 与类合并）；
# 2. 同步保活构造器（含 `SerializationConstructorMarker` 合成构造器）、`Companion`、`INSTANCE`、`serializer(...)`；
# 3. 对所有存活的 `@Serializable` 类，同步锁死 `<1>$Companion` 与 `<1>$$serializer`。
# ==============================================================================

-keepattributes RuntimeVisibleAnnotations,AnnotationDefault,Signature,InnerClasses,EnclosingMethod

# 合成 Companion 与 $$serializer 保活（仅对已存活的 @Serializable 类触发，不阻止死 DTO 正常收缩）
-if @kotlinx.serialization.Serializable class **
-keep class <1>$Companion {
    <init>(...);
    kotlinx.serialization.KSerializer serializer(...);
}

-if @kotlinx.serialization.Serializable class **
-keep class <1>$$serializer { *; }

# ---------- :ai 模块 ----------

-keep class app.androidrik.ai.core.InputSchema {
    <init>(...);
    static ** Companion;
    public static ** INSTANCE;
    kotlinx.serialization.KSerializer serializer(...);
}
-keep class * extends app.androidrik.ai.core.InputSchema {
    <init>(...);
    static ** Companion;
    public static ** INSTANCE;
    kotlinx.serialization.KSerializer serializer(...);
}

