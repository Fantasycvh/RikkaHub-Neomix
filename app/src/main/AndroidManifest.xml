<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!--
    定时任务到点唤醒（docs/design/design-scheduled-ai-tasks.md §六）：
    WorkManager 在 Doze 熄屏下不保证到点执行（2026-10-30 真机实测延迟 2 分钟以上直到亮屏），
    因此用 AlarmManager 的 setExactAndAllowWhileIdle 做主唤醒。该权限是「特殊应用权限」，
    用户可在系统设置「闹钟和提醒」里授予；未授予时代码退化为 setAndAllowWhileIdle
    （Doze 也放行，但可能被系统挪动几分钟）。
  -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <!--
    TTS 朗读浮窗（FloatingX）：系统级 overlay 需要「显示在其他应用上层」。
    此前一直漏声明 ⇒ Settings.canDrawOverlays 恒为 false，TTS 浮窗实际从未显示过。
  -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <uses-feature
    android:name="android.hardware.camera"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.camera.autofocus"
    android:required="false" />

  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
    <!-- 用于解析屏幕使用时间里各 App 的名称(可见性受 Android 11+ 包可见性限制) -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- 用于识别桌面 launcher 以便在屏幕使用时间中排除 -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application
    android:name=".RikkaHubApp"
    android:largeHeap="true"
    android:allowBackup="true"
    android:appCategory="productivity"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Rikkahub"
    android:usesCleartextTraffic="true"
    tools:targetApi="33">
    <activity
      android:name=".ui.activity.SafeModeActivity"
      android:exported="false"
      android:label="@string/title_activity_safe_mode"
      android:theme="@style/Theme.Rikkahub" />
    <activity
      android:name=".RouteActivity"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:exported="true"
      android:importantForAutofill="noExcludeDescendants"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- 静态快捷方式声明挂在默认桌面入口上（切到其它预置后长按不可见属预期） -->
      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts" />
      <intent-filter>
        <action android:name="android.intent.action.SEND" />

        <category android:name="android.intent.category.DEFAULT" />

        <data android:mimeType="text/plain" />
      </intent-filter>
      <!-- PROCESS_TEXT（划词）已迁至 ProcessTextTranslatorActivity：轻弹窗直翻，不再打开整个 App -->
      <intent-filter>
        <action android:name="app.androidrik.rikkahub.action.TRANSLATE" />

        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>

      <intent-filter>
        <action android:name="app.androidrik.rikkahub.action.IMAGE_GEN" />

        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
    <!--
      跨应用划词翻译：系统文本选择菜单 → "Translate with RikkaHub" → 对话框样式 Activity。
      filter 只挂本 Activity 一处（不随桌面图标预置切换，菜单文案固定，见 miffan.md 不照搬节）
    -->
    <activity
      android:name=".ui.activity.ProcessTextTranslatorActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/process_text_translate_label"
      android:theme="@style/Theme.Rikkahub.ProcessText"
      android:windowSoftInputMode="adjustResize">
      <intent-filter
        android:label="@string/process_text_translate_label"
        android:priority="100">
        <action android:name="android.intent.action.PROCESS_TEXT" />

        <category android:name="android.intent.category.DEFAULT" />

        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>
    <!--
      桌面「名称 + 图标」预置入口：真实 Activity（RouteActivity 子类），不用 activity-alias。
      原因见 LauncherRikkaHubActivity 注释：ROM 的组件开关 hook 校验 alias 会失败。
      RouteActivity 是默认入口（Neomix），切换时由 LauncherAlias 把本体与预置互斥启停。
    -->
    <activity
      android:name=".LauncherRikkaHubActivity"
      android:enabled="false"
      android:exported="true"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:importantForAutofill="noExcludeDescendants"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name_variant_rikkahub"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity
      android:name=".LauncherChatActivity"
      android:enabled="false"
      android:exported="true"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:importantForAutofill="noExcludeDescendants"
      android:icon="@mipmap/ic_launcher_chat"
      android:label="@string/app_name_variant_chat"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity
      android:name=".LauncherNotesActivity"
      android:enabled="false"
      android:exported="true"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:importantForAutofill="noExcludeDescendants"
      android:icon="@mipmap/ic_launcher_notes"
      android:label="@string/app_name_variant_notes"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity
      android:name=".LauncherAssistantActivity"
      android:enabled="false"
      android:exported="true"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:importantForAutofill="noExcludeDescendants"
      android:icon="@mipmap/ic_launcher_assistant"
      android:label="@string/app_name_variant_assistant"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity
      android:name=".ShortcutEntryActivity"
      android:enabled="true"
      android:exported="true"
      android:theme="@android:style/Theme.NoDisplay" />
    <activity
      android:name=".ui.activity.ShortcutHandlerActivity"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />

        <data
          android:host="shortcut"
          android:scheme="rikkahub" />
      </intent-filter>
    </activity>
    <activity
      android:name=".ui.activity.McpOAuthCallbackActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
          android:host="mcp-oauth-callback"
          android:scheme="rikkahub" />
      </intent-filter>
    </activity>
    <service
      android:name=".service.WebServerService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="local web server for LLM chat UI" />
    </service>

    <service
      android:name=".tikz.TexCompileService"
      android:exported="false"
      android:process=":texcompile" />

    <service
      android:name=".service.KeepAliveService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Keep AI chat generation running while the app is in the background" />
    </service>

    <!-- 媒体生成（dataSync）：任务本身由 Koin 单例 MediaCreationService 持有，本服务只把进程留在前台 -->
    <service
      android:name=".service.MediaCreationForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!--
      子代理审批（设计 §十一）：通知栏「批准 / 拒绝」按钮的落点。
      exported=false —— 审批是权限动作，不给外部任何入口；Intent 只带 toolCallId 与布尔。
    -->
    <receiver
      android:name=".service.SubagentApprovalReceiver"
      android:exported="false" />

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
    <provider
      android:name=".data.provider.WorkspaceDocumentsProvider"
      android:authorities="${applicationId}.documents"
      android:exported="true"
      android:grantUriPermissions="true"
      android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
    <!--
      定时任务唤醒 / 执行载体（docs/design/design-scheduled-ai-tasks.md §六「触发层」）：
      闹钟广播（exported=false：PendingIntent 只由本应用创建）拉起执行专用前台服务。
      执行期同持 partial wakelock + Wi-Fi 高性能锁，Doze/熄屏下生成不被冻、流式回包不断。
    -->
    <receiver
      android:name=".service.ScheduledTaskAlarmReceiver"
      android:exported="false" />

    <service
      android:name=".service.ScheduledTaskRunService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="dataSync" />

    <!--
      定时任务 Worker 执行期用 setForeground 挂前台服务（防后台生成被 ColorOS/大厂 ROM 的
      cached-app freezer 冻结——实测冷启动进程生成到一半被冻，回前台才续上）。
      API 34+ 要求 FGS 必须声明类型：给 WorkManager 的 FGS 载体合并 dataSync 类型
      （FOREGROUND_SERVICE_DATA_SYNC 权限本仓已声明）。
    -->
    <service
      android:name="androidx.work.impl.foreground.SystemForegroundService"
      android:foregroundServiceType="dataSync"
      tools:node="merge" />
  </application>

</manifest>
